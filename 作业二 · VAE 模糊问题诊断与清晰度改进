{"cells":[{"cell_type":"markdown","id":"bab55fdf","metadata":{"papermill":{"duration":0.002801,"end_time":"2026-11-02T15:33:48.953008+00:00","exception":false,"start_time":"2026-11-02T15:33:48.950207+00:00","status":"completed"},"tags":[]},"source":["# 作业二 · VAE 模糊问题诊断与清晰度改进（Kaggle 完整对照）\n","\n","这份 Notebook 解决的是**模型本身输出灰色、混合笔画**，而不是仅仅提高 PNG 的 DPI。使用同一份 MNIST IDX 数据、同一个固定训练/验证拆分和四维潜变量，依次对照原全连接 VAE+MSE、卷积 VAE+MSE、卷积 VAE+BCEWithLogits。\n","\n","- 第一次保持 `CONFIRM_FINAL=False`：只根据验证集和独立先验生成样本对照、保存文件，不以测试集挑参数。\n","- 生成的 `smooth` 和 `threshold` 预览只是**显示方式**，不计入训练和重建指标，也不代表生成能力改善。\n","- 不承诺卷积/BCE 一定提高所有类别：最终以 MSE、随机生成图片、分类器代理指标和人工观察共同判断。\n","- 注：MSE 与 BCE 是不同尺度的目标，同样的数值 β 不代表完全相同的正则化强度，因此该实验用于探索，不能把训练总损失作跨目标公平排序。"]},{"cell_type":"code","execution_count":1,"id":"18ff4339","metadata":{"execution":{"iopub.execute_input":"2026-11-02T15:33:48.958522Z","iopub.status.busy":"2026-11-02T15:33:48.958105Z","iopub.status.idle":"2026-11-02T15:34:02.061479Z","shell.execute_reply":"2026-11-02T15:34:02.060645Z"},"papermill":{"duration":13.108178,"end_time":"2026-11-02T15:34:02.063253+00:00","exception":false,"start_time":"2026-11-02T15:33:48.955075+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["device: cuda data: /kaggle/input/datasets/yuesun0502/cnnmodel-database-minist output: /kaggle/working/hw2_results/vae_sharpness_v1\n"]}],"source":["from pathlib import Path\n","import os, struct, random, json, csv, zipfile, shutil, gc, copy\n","import numpy as np\n","import torch\n","from torch import nn\n","import torch.nn.functional as F\n","from torch.utils.data import Dataset, DataLoader, Subset\n","import matplotlib.pyplot as plt\n","\n","DATA_ROOT=Path(os.getenv('VAE_IDX_ROOT', '/kaggle/input/datasets/yuesun0502/cnnmodel-database-minist'))\n","WORK_ROOT=Path(os.getenv('VAE_OUTPUT_ROOT', '/kaggle/working' if Path('/kaggle/working').is_dir() else str(Path.cwd())))\n","FAST_DEV_RUN=os.getenv('VAE_FAST_DEV_RUN','0')=='1'\n","ROOT=WORK_ROOT/'hw2_results'/('vae_sharpness_debug' if FAST_DEV_RUN else 'vae_sharpness_v1')\n","EXPERIMENTS=ROOT/'experiments'; COMPARE=ROOT/'comparisons'; TABLES=ROOT/'tables'\n","for p in (EXPERIMENTS,COMPARE,TABLES): p.mkdir(parents=True,exist_ok=True)\n","\n","LATENT_DIM=4; BETA=0.0005; EPOCHS=40; BATCH_SIZE=256; LR=1e-4; VAL_COUNT=5000; SEED=42\n","# 模型/损失的独立对照；不会修改之前的输出目录\n","CONFIGS=[('mlp_mse','mlp','mse'),('conv_mse','conv','mse'),('conv_bce','conv','bce')]\n","PRIOR_N=2000; GENERATED_GRID_N=64; CLASSIFIER_EPOCHS=3\n","CONFIRM_FINAL=False  # 在认真检查比较图后才改 True\n","FINAL_RUN='conv_bce' # 可手动选 conv_mse / mlp_mse；无需按最低MSE强制决定\n","RECON_TOLERANCE=0.15\n","if FAST_DEV_RUN:\n","    EPOCHS=1;BATCH_SIZE=16;VAL_COUNT=32;PRIOR_N=32;GENERATED_GRID_N=16;CLASSIFIER_EPOCHS=1\n","\n","device=torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","\n","def seed_all(seed):\n","    random.seed(seed);np.random.seed(seed);torch.manual_seed(seed)\n","    if torch.cuda.is_available():torch.cuda.manual_seed_all(seed)\n","seed_all(SEED)\n","print('device:',device,'data:',DATA_ROOT,'output:',ROOT)"]},{"cell_type":"markdown","id":"2b56d730","metadata":{"papermill":{"duration":0.002124,"end_time":"2026-11-02T15:34:02.067419+00:00","exception":false,"start_time":"2026-11-02T15:34:02.065295+00:00","status":"completed"},"tags":[]},"source":["## 1. 保留原 Kaggle 的 MNIST IDX 路径，并从训练集划分验证集"]},{"cell_type":"code","execution_count":2,"id":"6335c579","metadata":{"execution":{"iopub.execute_input":"2026-11-02T15:34:02.07452Z","iopub.status.busy":"2026-11-02T15:34:02.074159Z","iopub.status.idle":"2026-11-02T15:34:04.48405Z","shell.execute_reply":"2026-11-02T15:34:04.483103Z"},"papermill":{"duration":2.416241,"end_time":"2026-11-02T15:34:04.485659+00:00","exception":false,"start_time":"2026-11-02T15:34:02.069418+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["train: 55000 validation: 5000 test (held out): 10000\n"]}],"source":["IDX={\n"," 'train_images':DATA_ROOT/'train-images-idx3-ubyte'/'train-images.idx3-ubyte',\n"," 'train_labels':DATA_ROOT/'train-labels-idx1-ubyte'/'train-labels.idx1-ubyte',\n"," 'test_images':DATA_ROOT/'t10k-images-idx3-ubyte'/'t10k-images.idx3-ubyte',\n"," 'test_labels':DATA_ROOT/'t10k-labels-idx1-ubyte'/'t10k-labels.idx1-ubyte',\n","}\n","missing=[str(p) for p in IDX.values() if not p.is_file()]\n","if missing: raise FileNotFoundError('请挂载原 MNIST IDX 数据集。缺失:\\n'+'\\n'.join(missing))\n","\n","def read_images(path):\n","    with path.open('rb') as f:\n","        magic,n,h,w=struct.unpack('>IIII',f.read(16));a=np.frombuffer(f.read(),np.uint8).copy()\n","    if (magic,h,w)!=(2051,28,28) or len(a)!=n*784:raise ValueError(path)\n","    return torch.from_numpy(a.reshape(n,1,28,28))\n","def read_labels(path):\n","    with path.open('rb') as f:\n","        magic,n=struct.unpack('>II',f.read(8));a=np.frombuffer(f.read(),np.uint8).copy()\n","    if magic!=2049 or len(a)!=n:raise ValueError(path)\n","    return torch.from_numpy(a).long()\n","\n","class IDXMNIST(Dataset):\n","    def __init__(self,split,limit=0):\n","        self.X=read_images(IDX[split+'_images']);self.y=read_labels(IDX[split+'_labels'])\n","        assert len(self.X)==len(self.y)\n","        if limit: self.X=self.X[:limit];self.y=self.y[:limit]\n","    def __len__(self):return len(self.y)\n","    def __getitem__(self,i):return self.X[i].float()/255.0,self.y[i]\n","\n","full=IDXMNIST('train',160 if FAST_DEV_RUN else 0)\n","test_data=IDXMNIST('test',64 if FAST_DEV_RUN else 0)\n","val_count=min(VAL_COUNT,len(full)//4)\n","perm=torch.randperm(len(full),generator=torch.Generator().manual_seed(2026))\n","train_idx=perm[:-val_count].tolist();val_idx=perm[-val_count:].tolist()\n","train_data=Subset(full,train_idx);val_data=Subset(full,val_idx)\n","np.savez_compressed(TABLES/'split_indices.npz',train_idx=train_idx,val_idx=val_idx)\n","val_loader=DataLoader(val_data,batch_size=BATCH_SIZE,shuffle=False,num_workers=0)\n","test_loader=DataLoader(test_data,batch_size=BATCH_SIZE,shuffle=False,num_workers=0)\n","\n","def train_loader_for(epoch,seed=SEED):\n","    g=torch.Generator().manual_seed(seed*10000+epoch)\n","    return DataLoader(train_data,batch_size=BATCH_SIZE,shuffle=True,generator=g,num_workers=0)\n","\n","def one_per_class(ds):\n","    example={}\n","    for i in range(len(ds)):\n","        x,y=ds[i];y=int(y)\n","        if y not in example:example[y]=x\n","        if len(example)==10:break\n","    return sorted(example),torch.stack([example[k] for k in sorted(example)])\n","DIGITS,EXAMPLES=one_per_class(val_data)\n","print('train:',len(train_data),'validation:',len(val_data),'test (held out):',len(test_data))"]},{"cell_type":"markdown","id":"7a4ea72c","metadata":{"papermill":{"duration":0.002075,"end_time":"2026-11-02T15:34:04.489901+00:00","exception":false,"start_time":"2026-11-02T15:34:04.487826+00:00","status":"completed"},"tags":[]},"source":["## 2. 三个模型的定义\n","\n","- `MLPVAE` 复现原始全连接架构，输出改为 logits，但实际 MSE 仍对 `sigmoid(logits)` 计算，因此其数学输出与原版一致。\n","- `ConvVAE` 在28×28像素空间提取局部笔画结构，保持潜变量仍为4维。\n","- `conv_mse` 与 `conv_bce` 使用**完全相同的卷积结构**，便于分析重建目标的作用。"]},{"cell_type":"code","execution_count":3,"id":"01fd759e","metadata":{"execution":{"iopub.execute_input":"2026-11-02T15:34:04.4955Z","iopub.status.busy":"2026-11-02T15:34:04.494938Z","iopub.status.idle":"2026-11-02T15:34:07.702493Z","shell.execute_reply":"2026-11-02T15:34:07.701595Z"},"papermill":{"duration":3.212419,"end_time":"2026-11-02T15:34:07.704213+00:00","exception":false,"start_time":"2026-11-02T15:34:04.491794+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["mlp_mse parameters: 211256\n","conv_mse parameters: 874441\n","conv_bce parameters: 874441\n"]}],"source":["class MLPVAE(nn.Module):\n","    def __init__(self,d=4):\n","        super().__init__();self.d=d\n","        self.encoder=nn.Sequential(nn.Flatten(),nn.Linear(784,128),nn.ReLU(),nn.Linear(128,32),nn.ReLU(),nn.Linear(32,16),nn.ReLU(),nn.Linear(16,d*2))\n","        self.decoder=nn.Sequential(nn.Linear(d,16),nn.ReLU(),nn.Linear(16,32),nn.ReLU(),nn.Linear(32,128),nn.ReLU(),nn.Linear(128,784))\n","    def encode(self,x):return self.encoder(x).chunk(2,dim=1)\n","    def decode_logits(self,z):return self.decoder(z).reshape(-1,1,28,28)\n","    def decode(self,z):return torch.sigmoid(self.decode_logits(z))\n","    def forward(self,x):\n","        mu,lv=self.encode(x);z=mu+torch.exp(.5*lv)*torch.randn_like(mu)\n","        logits=self.decode_logits(z)\n","        return logits,mu,lv\n","\n","class ConvVAE(nn.Module):\n","    def __init__(self,d=4):\n","        super().__init__();self.d=d\n","        self.features=nn.Sequential(\n","            nn.Conv2d(1,32,4,2,1),nn.ReLU(),  # 14 x 14\n","            nn.Conv2d(32,64,4,2,1),nn.ReLU(), # 7 x 7\n","            nn.Flatten(),nn.Linear(64*7*7,128),nn.ReLU())\n","        self.mu=nn.Linear(128,d);self.lv=nn.Linear(128,d)\n","        self.up=nn.Sequential(nn.Linear(d,128),nn.ReLU(),nn.Linear(128,64*7*7),nn.ReLU())\n","        self.deconv=nn.Sequential(nn.ConvTranspose2d(64,32,4,2,1),nn.ReLU(),nn.ConvTranspose2d(32,1,4,2,1))\n","    def encode(self,x):\n","        h=self.features(x);return self.mu(h),self.lv(h)\n","    def decode_logits(self,z):return self.deconv(self.up(z).reshape(-1,64,7,7))\n","    def decode(self,z):return torch.sigmoid(self.decode_logits(z))\n","    def forward(self,x):\n","        mu,lv=self.encode(x);z=mu+torch.exp(.5*lv)*torch.randn_like(mu)\n","        return self.decode_logits(z),mu,lv\n","\n","def new_model(family):return MLPVAE(LATENT_DIM) if family=='mlp' else ConvVAE(LATENT_DIM)\n","def compute_loss(logits,x,mu,lv,loss_kind,beta):\n","    recon=torch.sigmoid(logits)\n","    mse=F.mse_loss(recon,x,reduction='mean')\n","    bce=F.binary_cross_entropy_with_logits(logits,x,reduction='mean')\n","    kl=(.5*(mu.square()+lv.exp()-1-lv)).sum(dim=1).mean()\n","    loss=(mse if loss_kind=='mse' else bce)+beta*kl\n","    return loss,mse,bce,kl\n","\n","for label,family,lk in CONFIGS:\n","    m=new_model(family).to(device)\n","    logits,mu,lv=m(torch.rand(3,1,28,28,device=device))\n","    assert logits.shape==(3,1,28,28) and mu.shape==(3,4)\n","    loss,*_=compute_loss(logits,torch.rand(3,1,28,28,device=device),mu,lv,lk,BETA)\n","    loss.backward();print(label,'parameters:',sum(p.numel() for p in m.parameters()))\n","    del m"]},{"cell_type":"markdown","id":"82d00f98","metadata":{"papermill":{"duration":0.002391,"end_time":"2026-11-02T15:34:07.709056+00:00","exception":false,"start_time":"2026-11-02T15:34:07.706665+00:00","status":"completed"},"tags":[]},"source":["## 3. 断点保存：每个模型独立输出，保存 CPU 权重与 Adam 状态\n","\n","恢复 CUDA RNG 时使用 CPU ByteTensor，以避免此前出现的 `RNG state must be a torch.ByteTensor`。不删除其他作业目录。"]},{"cell_type":"code","execution_count":4,"id":"55d3374a","metadata":{"execution":{"iopub.execute_input":"2026-11-02T15:34:07.715563Z","iopub.status.busy":"2026-11-02T15:34:07.715287Z","iopub.status.idle":"2026-11-02T15:34:07.731153Z","shell.execute_reply":"2026-11-02T15:34:07.730522Z"},"papermill":{"duration":0.021171,"end_time":"2026-11-02T15:34:07.732598+00:00","exception":false,"start_time":"2026-11-02T15:34:07.711427+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def cpu_tree(x):\n","    if isinstance(x,torch.Tensor):return x.detach().cpu().clone()\n","    if isinstance(x,dict):return {k:cpu_tree(v) for k,v in x.items()}\n","    if isinstance(x,list):return [cpu_tree(v) for v in x]\n","    if isinstance(x,tuple):return tuple(cpu_tree(v) for v in x)\n","    return x\n","\n","def save_ckpt(path,model,opt,epoch,history,config):\n","    state={'model':cpu_tree(model.state_dict()),'optimizer':cpu_tree(opt.state_dict()),\n","           'epoch':epoch,'history':history,'config':config,'rng_torch':torch.get_rng_state().cpu(),\n","           'rng_numpy':np.random.get_state(),'rng_python':random.getstate(),\n","           'rng_cuda':[s.cpu() for s in torch.cuda.get_rng_state_all()] if torch.cuda.is_available() else []}\n","    path=Path(path);temp=path.with_suffix('.tmp');torch.save(state,temp);temp.replace(path)\n","    if epoch in (20,EPOCHS):torch.save(state,path.parent/f'checkpoint_epoch_{epoch}.pt')\n","\n","def load_ckpt(path,model,opt=None,restore_rng=False):\n","    # 仅加载本实验可信代码产生的检查点\n","    state=torch.load(path,map_location='cpu',weights_only=False)\n","    model.load_state_dict(state['model'])\n","    if opt is not None:opt.load_state_dict(state['optimizer'])\n","    if restore_rng:\n","        torch.set_rng_state(state['rng_torch'].to('cpu',dtype=torch.uint8))\n","        np.random.set_state(state['rng_numpy']);random.setstate(state['rng_python'])\n","        if torch.cuda.is_available() and len(state.get('rng_cuda',[]))==torch.cuda.device_count():\n","            torch.cuda.set_rng_state_all([t.to('cpu',dtype=torch.uint8).contiguous() for t in state['rng_cuda']])\n","    return state\n","\n","def write_csv(path,rows,fields):\n","    with open(path,'w',newline='',encoding='utf-8-sig') as f:\n","        w=csv.DictWriter(f,fieldnames=fields,extrasaction='ignore');w.writeheader();w.writerows(rows)\n","\n","def train_one(label,family,loss_kind):\n","    out=EXPERIMENTS/label;out.mkdir(exist_ok=True)\n","    config=dict(name=label,family=family,loss_kind=loss_kind,latent_dim=LATENT_DIM,beta=BETA,epochs=EPOCHS,seed=SEED,\n","                train_count=len(train_data),val_count=len(val_data),learning_rate=LR,batch_size=BATCH_SIZE)\n","    seed_all(SEED)\n","    model=new_model(family).to(device)\n","    optimizer=torch.optim.Adam(model.parameters(),lr=LR)\n","    last=out/'checkpoint_latest.pt';history=[];start=0\n","    if last.exists():\n","        ck=load_ckpt(last,model,optimizer,restore_rng=True)\n","        if any(ck['config'][k]!=config[k] for k in ('family','loss_kind','latent_dim','beta','seed')):\n","            raise RuntimeError('检查点配置不匹配，请切换输出目录，不能混用不同模型。')\n","        start=int(ck['epoch']);history=list(ck['history']);print(label,'resume from',start)\n","    for epoch in range(start+1,EPOCHS+1):\n","        model.train();agg=np.zeros(4);n=0\n","        for x,_ in train_loader_for(epoch):\n","            x=x.to(device);logits,mu,lv=model(x)\n","            loss,mse,bce,kl=compute_loss(logits,x,mu,lv,loss_kind,BETA)\n","            optimizer.zero_grad(set_to_none=True);loss.backward();optimizer.step()\n","            agg+=np.array([loss.item(),mse.item(),bce.item(),kl.item()])*len(x);n+=len(x)\n","        row={'epoch':epoch,'train_total':agg[0]/n,'train_mse':agg[1]/n,'train_bce':agg[2]/n,'train_kl':agg[3]/n}\n","        history.append(row)\n","        if epoch%5==0 or epoch==1 or epoch==EPOCHS:\n","            save_ckpt(last,model,optimizer,epoch,history,config)\n","            print(f'{label} {epoch}/{EPOCHS}: MSE={row[\"train_mse\"]:.5f}, BCE={row[\"train_bce\"]:.4f}, KL={row[\"train_kl\"]:.3f}')\n","    if not last.exists():save_ckpt(last,model,optimizer,EPOCHS,history,config)\n","    write_csv(out/'training_history.csv',history,['epoch','train_total','train_mse','train_bce','train_kl'])\n","    (out/'config.json').write_text(json.dumps(config,indent=2),encoding='utf-8')\n","    return model,out"]},{"cell_type":"markdown","id":"1b0887e0","metadata":{"papermill":{"duration":0.001989,"end_time":"2026-11-02T15:34:07.736733+00:00","exception":false,"start_time":"2026-11-02T15:34:07.734744+00:00","status":"completed"},"tags":[]},"source":["## 4. 完整验证集评价：均值重建、随机重建、类别误差、逐维 KL\n","\n","所有模型采用同一评价指标：模型训练目标可以不同，但验证集 MSE 是可比较的。"]},{"cell_type":"code","execution_count":5,"id":"16cc895f","metadata":{"execution":{"iopub.execute_input":"2026-11-02T15:34:07.74196Z","iopub.status.busy":"2026-11-02T15:34:07.741608Z","iopub.status.idle":"2026-11-02T15:34:07.760019Z","shell.execute_reply":"2026-11-02T15:34:07.759187Z"},"papermill":{"duration":0.022856,"end_time":"2026-11-02T15:34:07.761497+00:00","exception":false,"start_time":"2026-11-02T15:34:07.738641+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["@torch.no_grad()\n","def evaluate(model,loader,repeat=3):\n","    model.eval();sse=0.;sample_sse=0.;bce_sum=0.;pixels=0;nimgs=0;kl_sum=0.\n","    class_sse=np.zeros(10);class_n=np.zeros(10,int)\n","    per_dim=np.zeros(LATENT_DIM)\n","    generator=torch.Generator(device=device.type).manual_seed(876543)\n","    for x,y in loader:\n","        x=x.to(device);mu,lv=model.encode(x);pred=model.decode(mu)\n","        s=((pred-x)**2).flatten(1).sum(dim=1)\n","        sse+=s.sum().item();pixels+=x.numel();nimgs+=len(x)\n","        bce_sum+=F.binary_cross_entropy(pred.clamp(1e-6,1-1e-6),x,reduction='sum').item()\n","        k=(.5*(mu.square()+lv.exp()-1-lv));per_dim+=k.sum(dim=0).cpu().numpy();kl_sum+=k.sum().item()\n","        y_np=y.numpy();ss=s.cpu().numpy()\n","        for c in range(10):\n","            mask=y_np==c;class_sse[c]+=ss[mask].sum();class_n[c]+=mask.sum()\n","        sd=torch.exp(.5*lv)\n","        for _ in range(repeat):\n","            eps=torch.randn(mu.shape,device=device,generator=generator)\n","            r=model.decode(mu+sd*eps);sample_sse+=(r-x).square().sum().item()\n","    return {'mean_mse':sse/pixels,'sample_mse':sample_sse/(pixels*repeat),\n","            'mean_bce':bce_sum/pixels,'total_kl':kl_sum/nimgs,'kl_per_dim':(per_dim/nimgs).tolist(),\n","            'per_digit_mse':{str(c):float(class_sse[c]/(class_n[c]*784)) if class_n[c] else None for c in range(10)}}\n","\n","@torch.no_grad()\n","def prior_draw(model,n,seed=9001):\n","    model.eval();rng=torch.Generator(device=device.type).manual_seed(seed);outs=[]\n","    for start in range(0,n,256):\n","        z=torch.randn(min(n-start,256),LATENT_DIM,device=device,generator=rng)\n","        outs.append(model.decode(z).cpu())\n","    return torch.cat(outs)\n","\n","# 参考分类器沿用之前的结构，训练于训练子集，不接触测试集\n","class DigitClassifier(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.net=nn.Sequential(nn.Conv2d(1,16,3,padding=1),nn.ReLU(),nn.MaxPool2d(2),\n","            nn.Conv2d(16,32,3,padding=1),nn.ReLU(),nn.MaxPool2d(2),nn.Flatten(),nn.Linear(32*7*7,128),nn.ReLU(),nn.Linear(128,10))\n","    def forward(self,x):return self.net(x)\n","\n","def train_classifier():\n","    path=ROOT/'reference_classifier.pt';seed_all(987)\n","    clf=DigitClassifier().to(device)\n","    if path.exists():clf.load_state_dict(torch.load(path,map_location='cpu',weights_only=True))\n","    else:\n","        opt=torch.optim.Adam(clf.parameters(),lr=0.001)\n","        for ep in range(1,CLASSIFIER_EPOCHS+1):\n","            clf.train();n=0;correct=0\n","            for x,y in train_loader_for(ep,987):\n","                x=x.to(device);y=y.to(device)\n","                logits=clf(x);loss=F.cross_entropy(logits,y);opt.zero_grad(set_to_none=True);loss.backward();opt.step()\n","                n+=len(y);correct+=(logits.argmax(1)==y).sum().item()\n","            print('Classifier epoch',ep,'train accuracy',round(correct/n,4))\n","        torch.save(cpu_tree(clf.state_dict()),path)\n","    clf.eval();n=0;correct=0\n","    with torch.no_grad():\n","        for x,y in val_loader:\n","            p=clf(x.to(device)).argmax(1).cpu();n+=len(y);correct+=(p==y).sum().item()\n","    acc=correct/n;print('classifier validation accuracy:',round(acc,4))\n","    return clf,acc\n","\n","@torch.no_grad()\n","def prior_proxy(model,clf,n):\n","    samples=prior_draw(model,n);counts=np.zeros(10,int);good=0;conf_sum=0\n","    clf.eval()\n","    for start in range(0,len(samples),256):\n","        logits=clf(samples[start:start+256].to(device));conf,p=logits.softmax(1).max(1)\n","        good+=(conf>=.8).sum().item();conf_sum+=conf.sum().item()\n","        counts+=np.bincount(p.cpu().numpy(),minlength=10)\n","    f=counts/counts.sum();h=-(f[f>0]*np.log(f[f>0])).sum()/np.log(10)\n","    return {'conf_ge08':good/n,'conf_mean':conf_sum/n,'class_entropy':float(h),'counts':counts.tolist()}"]},{"cell_type":"markdown","id":"5049b08b","metadata":{"papermill":{"duration":0.001909,"end_t