kaggle/working').is_dir() else Path.cwd()) / 'hw2_results' / 'vae'\n","RESULT_DIR.mkdir(parents=True, exist_ok=True)\n","print('Device:', device)\n"]},{"cell_type":"code","execution_count":2,"id":"692d4186","metadata":{"execution":{"iopub.execute_input":"2026-10-30T17:10:42.815186Z","iopub.status.busy":"2026-10-30T17:10:42.814542Z","iopub.status.idle":"2026-10-30T17:10:44.70799Z","shell.execute_reply":"2026-10-30T17:10:44.707117Z"},"papermill":{"duration":1.898519,"end_time":"2026-10-30T17:10:44.709765+00:00","exception":false,"start_time":"2026-10-30T17:10:42.811246+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["MNIST 输入路径: /kaggle/input/datasets/yuesun0502/cnnmodel-database-minist\n","VAE MNIST: 60000 images, shape=torch.Size([1, 28, 28]), range=[0,1]\n","首个 batch: (256, 1, 28, 28) (256,)\n"]}],"source":["BATCH_SIZE = 256\n","EPOCHS = 20\n","LR = 1e-4\n","KL_WEIGHT = 1e-3\n","HIDDEN_DIMS = [128, 32, 16, 4]  # 最后4个参数 = 二维均值 + 二维logvar\n","\n","# 从旧的 1_主体实验.ipynb 所用 Kaggle Dataset 中读取同一组 MNIST IDX 文件。\n","# VAE: [0,1] 灰度；GAN: [-1,1] 灰度。无需联网，也不会重复下载。\n","import struct\n","from torch.utils.data import Dataset, DataLoader\n","\n","DATA_ROOT = Path('/kaggle/input/datasets/yuesun0502/cnnmodel-database-minist')\n","IDX_FILES = {\n","    'train_images': DATA_ROOT / 'train-images-idx3-ubyte' / 'train-images.idx3-ubyte',\n","    'train_labels': DATA_ROOT / 'train-labels-idx1-ubyte' / 'train-labels.idx1-ubyte',\n","    'test_images': DATA_ROOT / 't10k-images-idx3-ubyte' / 't10k-images.idx3-ubyte',\n","    'test_labels': DATA_ROOT / 't10k-labels-idx1-ubyte' / 't10k-labels.idx1-ubyte',\n","}\n","\n","missing_files = [str(path) for path in IDX_FILES.values() if not path.is_file()]\n","if missing_files:\n","    raise FileNotFoundError(\n","        'Kaggle 中找不到旧 Notebook 使用的 MNIST IDX 文件。请确认在右侧 Input 添加了 '\n","        'yuesun0502/cnnmodel-database-minist，且目录与旧 Notebook 相同。\\n'\n","        '缺失文件：\\n' + '\\n'.join(missing_files)\n","    )\n","\n","def read_idx_images(path):\n","    with open(path, 'rb') as f:\n","        magic, count, rows, cols = struct.unpack('>IIII', f.read(16))\n","        if magic != 2051 or (rows, cols) != (28, 28):\n","            raise ValueError(f'无效的 MNIST IDX 图片头: {path}, magic={magic}, size={rows}x{cols}')\n","        raw = np.frombuffer(f.read(), dtype=np.uint8)\n","    if raw.size != count * rows * cols:\n","        raise ValueError(f'图片数量与 IDX 文件内容不匹配：{path}')\n","    return torch.from_numpy(raw.copy().reshape(count, 1, rows, cols))\n","\n","def read_idx_labels(path):\n","    with open(path, 'rb') as f:\n","        magic, count = struct.unpack('>II', f.read(8))\n","        if magic != 2049:\n","            raise ValueError(f'无效的 MNIST IDX 标签头: {path}, magic={magic}')\n","        raw = np.frombuffer(f.read(), dtype=np.uint8)\n","    if raw.size != count:\n","        raise ValueError(f'标签数量与 IDX 文件内容不匹配：{path}')\n","    return torch.from_numpy(raw.copy()).long()\n","\n","class KaggleIDXMNIST(Dataset):\n","    def __init__(self, split='train', pixel_range='zero_one'):\n","        if split not in ('train', 'test'):\n","            raise ValueError('split must be train or test')\n","        if pixel_range not in ('zero_one', 'minus_one_one'):\n","            raise ValueError('pixel_range must be zero_one or minus_one_one')\n","        prefix = 'train' if split == 'train' else 'test'\n","        self.images = read_idx_images(IDX_FILES[f'{prefix}_images'])\n","        self.labels = read_idx_labels(IDX_FILES[f'{prefix}_labels'])\n","        if len(self.images) != len(self.labels):\n","            raise ValueError('MNIST 图片和标签数量不匹配')\n","        self.pixel_range = pixel_range\n","\n","    def __len__(self):\n","        return len(self.images)\n","\n","    def __getitem__(self, i):\n","        # 在取数据时将 uint8 转成 float32，避免提前保存整套 float32 图片。\n","        image = self.images[i].float() / 255.0\n","        if self.pixel_range == 'minus_one_one':\n","            image = image * 2.0 - 1.0\n","        return image, self.labels[i]\n","\n","MNIST_dataset = KaggleIDXMNIST(split='train', pixel_range='zero_one')\n","MNIST_loader = DataLoader(\n","    MNIST_dataset, batch_size=BATCH_SIZE, shuffle=True,\n","    num_workers=0, pin_memory=(device.type == 'cuda')\n",")\n","image_shape = MNIST_dataset[0][0].shape\n","input_dim = int(np.prod(image_shape))\n","assert input_dim == 784\n","batch_images, batch_labels = next(iter(MNIST_loader))\n","assert batch_images.ndim == 4 and batch_images.shape[1:] == (1, 28, 28)\n","assert batch_images.min() >= 0 and batch_images.max() <= 1\n","print('MNIST 输入路径:', DATA_ROOT)\n","print(f'VAE MNIST: {len(MNIST_dataset)} images, shape={image_shape}, range=[0,1]')\n","print('首个 batch:', tuple(batch_images.shape), tuple(batch_labels.shape))\n"]},{"cell_type":"markdown","id":"cf0fe7d0","metadata":{"papermill":{"duration":0.001979,"end_time":"2026-10-30T17:10:44.713775+00:00","exception":false,"start_time":"2026-10-30T17:10:44.711796+00:00","status":"completed"},"tags":[]},"source":["## 1. VAE 模型\n","\n","Encoder 输出 $[\\mu(x),\\log\\sigma^2(x)]$；给定标准高斯噪声 $\\epsilon\\sim\\mathcal N(0,I)$，重参数化为 $z=\\mu+\\exp(\\tfrac12\\log\\sigma^2)\\odot\\epsilon$；Decoder 将 $z$ 映射回图像。以 `HIDDEN_DIMS=[128,32,16,4]` 为例，Encoder 为 $784\\to128\\to32\\to16\\to4$，Decoder 为 $2\\to16\\to32\\to128\\to784$。\n"]},{"cell_type":"code","execution_count":3,"id":"88e2af06","metadata":{"execution":{"iopub.execute_input":"2026-10-30T17:10:44.718874Z","iopub.status.busy":"2026-10-30T17:10:44.71863Z","iopub.status.idle":"2026-10-30T17:10:45.156869Z","shell.execute_reply":"2026-10-30T17:10:45.15603Z"},"papermill":{"duration":0.44306,"end_time":"2026-10-30T17:10:45.158688+00:00","exception":false,"start_time":"2026-10-30T17:10:44.715628+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["VAE shape test passed.\n"]}],"source":["class VAE(nn.Module):\n","    def __init__(self, input_dim, hidden_dims, decode_dim=-1, use_sigmoid=True):\n","        super().__init__()\n","        if not hidden_dims or hidden_dims[-1] % 2 != 0:\n","            raise ValueError('hidden_dims[-1] must be an even positive integer: mean + logvar')\n","        self.z_size = hidden_dims[-1] // 2\n","\n","        # Encoder: 最后一层不添加ReLU，因为mean、logvar必须允许负数。\n","        enc_dims = [input_dim] + list(hidden_dims)\n","        enc_layers = []\n","        for i in range(len(enc_dims) - 1):\n","            enc_layers.append(nn.Linear(enc_dims[i], enc_dims[i + 1]))\n","            if i < len(enc_dims) - 2:\n","                enc_layers.append(nn.ReLU())\n","        self.encoder = nn.Sequential(*enc_layers)\n","\n","        # Decoder: 从潜变量恢复到图像维度，末层Sigmoid匹配[0,1]的MNIST像素。\n","        output_dim = input_dim if decode_dim == -1 else decode_dim\n","        dec_dims = [self.z_size] + list(reversed(hidden_dims[:-1])) + [output_dim]\n","        dec_layers = []\n","        for i in range(len(dec_dims) - 1):\n","            dec_layers.append(nn.Linear(dec_dims[i], dec_dims[i + 1]))\n","            if i < len(dec_dims) - 2:\n","                dec_layers.append(nn.ReLU())\n","        if use_sigmoid:\n","            dec_layers.append(nn.Sigmoid())\n","        self.decoder = nn.Sequential(*dec_layers)\n","\n","    def encode(self, x):\n","        encoded = self.encoder(x)\n","        mean, logvar = torch.split(encoded, [self.z_size, self.z_size], dim=-1)\n","        return mean, logvar\n","\n","    def reparameterize(self, mean, logvar, n_samples_per_z=1):\n","        # 每次调用都会重新采样epsilon；不需要固定每张图像对应的噪声。\n","        std = torch.exp(0.5 * logvar)\n","        epsilon = torch.randn_like(std)\n","        return mean + std * epsilon\n","\n","    def decode(self, z):\n","        return self.decoder(z)\n","\n","    def forward(self, x, n_samples_per_z=1):\n","        mean, logvar = self.encode(x)\n","        batch_size, latent_dim = mean.shape\n","        if n_samples_per_z > 1:\n","            expanded_mean = mean[:, None, :].expand(-1, n_samples_per_z, -1)\n","            expanded_logvar = logvar[:, None, :].expand(-1, n_samples_per_z, -1)\n","            expanded_mean = expanded_mean.reshape(-1, latent_dim)\n","            expanded_logvar = expanded_logvar.reshape(-1, latent_dim)\n","        else:\n","            expanded_mean, expanded_logvar = mean, logvar\n","\n","        z = self.reparameterize(expanded_mean, expanded_logvar, n_samples_per_z)\n","        imgs = self.decode(z).reshape(batch_size, n_samples_per_z, -1).mean(dim=1)\n","        return {'imgs': imgs, 'z': z, 'mean': mean, 'logvar': logvar}\n","\n","# 快速维度检查，不依赖训练结果。\n","vae_shape_test = VAE(784, HIDDEN_DIMS).to(device)\n","test_x = torch.rand(5, 784, device=device)\n","test_out = vae_shape_test(test_x)\n","assert test_out['imgs'].shape == (5, 784)\n","assert test_out['mean'].shape == (5, 2)\n","assert test_out['logvar'].shape == (5, 2)\n","assert test_out['z'].shape == (5, 2)\n","print('VAE shape test passed.')\n","del vae_shape_test, test_x, test_out\n"]},{"cell_type":"markdown","id":"95d31d0f","metadata":{"papermill":{"duration":0.001848,"end_time":"2026-10-30T17:10:45.162599+00:00","exception":false,"start_time":"2026-10-30T17:10:45.160751+00:00","status":"completed"},"tags":[]},"source":["## 2. 损失函数与训练\n","\n","题目采用标准高斯先验和对角高斯后验，其解析 KL 为\n","\n","$$D_{KL}(q(z\\mid x)\\Vert p(z))=\\tfrac12\\sum_d\\big(\\mu_d^2+e^{\\mathrm{logvar}_d}-1-\\mathrm{logvar}_d\\big).$$\n","\n","老师给出的 `loss_KL_wo_E` 返回的是 **负 KL 项**。由于 `MSELoss()` 默认对所有像素和 batch 求平均，实际最小化的训练目标为\n","\n","$$L=\\operatorname{MSE}(\\hat x,x)+0.001\\,\\operatorname{mean}_{\\mathrm{batch}}D_{KL}(q(z\\mid x)\\Vert p(z)).$$\n","\n","重建部分仅对每幅图像采样一个 $z$；本实现没有将 MSE 误称为精确边缘似然。\n"]},{"cell_type":"code","execution_count":4,"id":"c26df990","metadata":{"execution":{"iopub.execute_input":"2026-10-30T17:10:45.167744Z","iopub.status.busy":"2026-10-30T17:10:45.167505Z","iopub.status.idle":"2026-10-30T17:10:45.589813Z","shell.execute_reply":"2026-10-30T17:10:45.589042Z"},"papermill":{"d