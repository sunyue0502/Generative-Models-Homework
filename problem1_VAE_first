1)\n","    axes[0].plot(epoch_axis, history['loss'], label='Total loss')\n","    axes[0].plot(epoch_axis, history['mse'], label='Reconstruction MSE')\n","    axes[0].set(xlabel='Epoch', ylabel='Loss', title='VAE training losses')\n","    axes[0].legend()\n","    axes[1].plot(epoch_axis, history['kl'], label='KL divergence')\n","    axes[1].set(xlabel='Epoch', ylabel='Mean KL', title='KL regularization')\n","    axes[1].legend()\n","    fig.tight_layout()\n","    if save_path is not None:\n","        fig.savefig(save_path, dpi=180, bbox_inches='tight')\n","    plt.show()\n","    plt.close(fig)\n"]},{"cell_type":"code","execution_count":7,"id":"6d15192b","metadata":{"execution":{"iopub.execute_input":"2026-10-30T17:11:29.366815Z","iopub.status.busy":"2026-10-30T17:11:29.366522Z","iopub.status.idle":"2026-10-30T17:11:32.415135Z","shell.execute_reply":"2026-10-30T17:11:32.414427Z"},"papermill":{"duration":3.054155,"end_time":"2026-10-30T17:11:32.417147+00:00","exception":false,"start_time":"2026-10-30T17:11:29.362992+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 500x1100 with 10 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x800 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 800x800 with 64 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1100x400 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["All VAE figures saved to: /kaggle/working/hw2_results/vae\n"]}],"source":["# 执行评估并保存作业报告需要的图像。\n","evaluate_reconstructions(\n","    vae_kl_wo_e, MNIST_dataset, n=5,\n","    save_path=RESULT_DIR / 'vae_reconstructions.png'\n",")\n","plot_latent_images(\n","    vae_kl_wo_e, n=8,\n","    save_path=RESULT_DIR / 'vae_latent_grid.png'\n",")\n","plot_random_samples(\n","    vae_kl_w