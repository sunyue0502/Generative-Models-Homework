r':stats['mu_var'][j]} for j in range(4)],\n","              ['dim','kl','std','mu_var'])\n","    del model;gc.collect()\n","    if device.type=='cuda':torch.cuda.empty_cache()\n","\n","write_csv(TABLES/'validation_comparison.csv',summaries,\n","          ['run','beta','warmup','seed','epochs','val_mean_mse','val_sample_mse','val_kl',\n","           'generated_confidence_ge_08','generated_entropy','generated_classes_1pct'])\n","print('验证集汇总：')\n","for row in sorted(summaries,key=lambda r:r['val_mean_mse']):\n","    print(row['run'],'val MSE',f\"{row['val_mean_mse']:.5f}\",\n","          'sample',f\"{row['val_sample_mse']:.5f}\",\n","          'KL',f\"{row['val_kl']:.3f}\",\n","          'prior confidence≥0.8',row['generated_confidence_ge_08'],\n","          'entropy',row['generated_entropy'])"]},{"cell_type":"markdown","id":"03c83086","metadata":{"papermill":{"duration":0.004564,"end_time":"2026-11-02T02:59:04.139917+00:00","exception":false,"start_time":"2026-11-02T02:59:04.135353+00:00","status":"completed"},"tags":[]},"source":["## 7. 训练完成后查看比较图（选模只使用验证集图像与先验采样）\n","\n","- `comparisons/same_images_mean_reconstructions.png` 用于观察 **验证集** 同一组数字的重建质量。\n","- `comparisons/prior_samples_comparison.png` 用于对照 **完全相同的四维标准高斯噪声** 所生成的图片。若有明显模糊、重复、类别缺失，应把对应 run 加入 `MANUAL_EXCLUDE_RUNS`。\n","- `comparisons/generation_proxies.png` 仅供辅助，分类器置信度和类别熵都无法替代人类对图像质量的判断。\n"]},{"cell_type":"code","execution_count":8,"id":"0ead74e3","metadata":{"execution":{"iopub.execute_input":"2026-11-02T02:59:04.151459Z","iopub.status.busy":"2026-11-02T02:59:04.15057Z","iopub.status.idle":"2026-11-02T02:59:15.470679Z","shell.execute_reply":"2026-11-02T02:59:15.469924Z"},"papermill":{"duration":11.328353,"end_time":"2026-11-02T02:59:15.472842+00:00","exception":false,"start_time":"2026-11-02T02:59:04.144489+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_for_view(row):\n","    model=VAE().to(device)\n","    folder=EXPERIMENTS/row['run']\n","    p=folder/f'checkpoint_epoch_{EPOCHS}.pt'\n","    if not p.exists():p=folder/'checkpoint_latest.pt'\n","    ck=load_checkpoint(p,model,restore_rng=False)\n","    if int(ck['epoch'])!=EPOCHS:raise RuntimeError(f'{row[\"run\"]} 没有达到 {EPOCHS} 轮')\n","    model.eval();return model,folder,ck\n","\n","# same source images vs all models\n","fig,axs=plt.subplots(len(DIGITS),1+len(summaries),figsize=(2.1*(1+len(summaries)),1.8*len(DIGITS)),squeeze=False)\n","for i,digit in enumerate(DIGITS):\n","    axs[i,0].imshow(EXAMPLE_X[i].reshape(28,28),cmap='gray',vmin=0,vmax=1)\n","    axs[i,0].set_title(f'Digit {digit} | original',fontsize=8);axs[i,0].axis('off')\n","for j,row in enumerate(summaries,1):\n","    model,_,_=load_for_view(row)\n","    with torch.no_grad():\n","        mu,_=model.encode(EXAMPLE_X.to(device));rec=model.decode(mu).cpu().reshape(-1,28,28)\n","    for i in range(len(DIGITS)):\n","        axs[i,j].imshow(rec[i],cmap='gray',vmin=0,vmax=1)\n","        axs[i,j].set_title(row['run'].split('_seed')[0],fontsize=8);axs[i,j].axis('off')\n","    del model\n","plt.tight_layout();plt.savefig(COMPARISONS/'same_images_mean_reconstructions.png',dpi=160);plt.close(fig)\n","\n","fig,axs=plt.subplots(len(summaries),12,figsize=(14,1.45*len(summaries)),squeeze=False)\n","for i,row in enumerate(summaries):\n","    model,_,_=load_for_view(row)\n","    ims=sample_prior(model,12).reshape(-1,28,28)\n","    for j in range(12):\n","        axs[i,j].imshow(ims[j],cmap='gray',vmin=0,vmax=1);axs[i,j].axis('off')\n","        if j==0:axs[i,j].set_ylabel(row['run'].split('_seed')[0],fontsize=9)\n","    del model\n","fig.suptitle('Independent prior samples: same Gaussian latent noise for all 4D models')\n","plt.tight_layout();plt.savefig(COMPARISONS/'prior_samples_comparison.png',dpi=170);plt.close(fig)\n","\n","# Save a larger 8×8 prior sample grid for each candidate, using the SAME\n","# standard-normal noise seed, to make human review of diversity less fragile.\n","for row in summaries:\n","    model,_,_=load_for_view(row)\n","    ims=sample_prior(model,64).reshape(64,28,28)\n","    fig,axes=plt.subplots(8,8,figsize=(9,9))\n","    for k,ax in enumerate(axes.flat):\n","        ax.imshow(ims[k],cmap='gray',vmin=0,vmax=1)\n","        ax.axis('off')\n","    fig.suptitle(row['run']+' | 64 independent prior samples',fontsize=12)\n","    fig.tight_layout()\n","    fig.savefig(COMPARISONS/('prior_64_'+row['run']+'.png'),dpi=170)\n","    plt.close(fig)\n","    del model\n","\n","\n","fig,axes=plt.subplots(1,3,figsize=(15,4.5))\n","for row in summaries:\n","    _,fold,ck=load_for_view(row)\n","    hist=ck['history']\n","    xx=[r['epoch'] for r in hist]\n","    nm=row['run'].split('_seed')[0]\n","    for ax,key in zip(axes,['train_mse','train_kl','train_total']):\n","        ax.plot(xx,[r[key] for r in hist],label=nm)\n","    del ck\n","for ax,title in zip(axes,['Training reconstruction MSE','Training KL','Training total loss']):\n","    ax.set_title(title);ax.set_xlabel('Epoch');ax.grid(alpha=.2)\n","axes[0].legend(fontsize=8)\n","fig.tight_layout();fig.savefig(COMPARISONS/'training_curves.png',dpi=170);plt.close(fig)\n","\n","fig,axes=plt.subplots(1,3,figsize=(14,4))\n","labels=[r['run'].split('_seed')[0] for r in summaries]\n","x=np.arange(len(summaries))\n","for ax,field,title in zip(axes,\n","                          ['val_mean_mse','val_sample_mse','val_kl'],\n","                          ['Validation mean MSE','Validation sample MSE','Validation total KL']):\n","    ax.bar(x,[r[field] for r in summaries]);ax.set_title(title)\n","    ax.set_xticks(x,labels,rotation=30,ha='right',fontsize=8);ax.grid(axis='y',alpha=.2)\n","fig.tight_layout();fig.savefig(COMPARISONS/'validation_metrics.png',dpi=170);plt.close(fig)\n","\n","if classifier is not None and clf_acc>=.95:\n","    fig,axes=plt.subplots(1,2,figsize=(11,4))\n","    for ax,field,title in zip(axes,['generated_confidence_ge_08','generated_entropy'],\n","                               ['Prior sample classifier confidence>=0.8',\n","                                'Prior sample predicted class entropy (normalized)']):\n","        ax.bar(x,[r[field] for r in summaries]);ax.set_xticks(x,labels,rotation=30,ha='right',fontsize=8)\n","        ax.set_ylim(0,1);ax.set_title(title);ax.grid(axis='y',alpha=.2)\n","    fig.tight_layout();fig.savefig(COMPARISONS/'generation_proxies.png',dpi=170);plt.close(fig)"]},{"cell_type":"markdown","id":"7eb04ddd","metadata":{"papermill":{"duration":0.004196,"end_time":"2026-11-02T02:59:15.481721+00:00","exception":false,"start_time":"2026-11-02T02:59:15.477525+00:00","status":"completed"},"tags":[]},"source":["## 8. 选择同时兼顾重建与随机生成的候选配置\n","\n","只用验证集与标准高斯先验样本评分。首先保留均值及随机重建 MSE 均不高于各自最优值 110% 的候选，然后在剩余模型中按四项指标等权（25% × 4）计算综合得分：**均值 MSE、随机 MSE、先验生成分类器高置信度比例、预测类别的归一化熵**。各指标在筛选后候选之间做 min–max 归一化；没有差异时记为 0.5，不人为放大微小差距。\n","\n","**注意：** 生成指标是辅助分类器代理，不是 FID、IS 或人类真实质量评分；当分类器在真实验证集准确率低于 95% 时，将停止自动给出“平衡最优”结论，仅列出重建候选并要求人工选定。人工目视核验前不运行最终测试。\n","\n","自动输出还包含 `prior_64_<run>.png`：每个候选 64 张固定噪声先验生成图片。相对差异小于 0.5% 的指标归一化后记为同分，综合得分差距小于或等于 0.03 时提示人工确认。"]},{"cell_type":"code","execution_count":9,"id":"8c64fcc3","metadata":{"execution":{"iopub.execute_input":"2026-11-02T02:59:15.492266Z","iopub.status.busy":"2026-11-02T02:59:15.491962Z","iopub.status.idle":"2026-11-02T02:59:15.520057Z","shell.execute_reply":"2026-11-02T02:59:15.51933Z"},"papermill":{"duration":0.036021,"end_time":"2026-11-02T02:59:15.522065+00:00","exception":false,"start_time":"2026-11-02T02:59:15.486044+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","符合双重重建门槛的模型排名：\n","1. beta_0.0001_seed_42: mean MSE=0.039043, sample MSE=0.039289, recon_score=1.000, gen_score=0.5, balanced_score=0.75\n","2. beta_0.0005_seed_42: mean MSE=0.039424, sample MSE=0.040484, recon_score=0.598, gen_score=0.5, balanced_score=0.5488627622788753\n","3. warmup_0.0005_seed_42: mean MSE=0.039648, sample MSE=0.040771, recon_score=0.436, gen_score=0.3306896350225601, balanced_score=0.3834415064786102\n","4. beta_0.0010_seed_42: mean MSE=0.040069, sample MSE=0.042047, recon_score=0.000, gen_score=0.5999584444710726, balanced_score=0.2999792222355363\n","生成代理指标可信： True 辅助分类器准确率： 0.9778\n","\n","推荐模型： beta_0.0001_seed_42\n","状态： pending_visual_review ；理由： 自动平衡评分推荐，需核对先验生成图\n","可视化： /kaggle/working/hw2_results/vae_final_4d_v2/comparisons/prior_samples_comparison.png\n","尚未完成先验生成图片目视核验：跳过测试集评价与最终模型权重导出。\n","请查看 comparisons/prior_samples_comparison.png，必要时填入 MANUAL_EXCLUDE_RUNS，\n","然后设置 VISUAL_REVIEW_CONFIRMED=True，仅重新运行第8-10节。\n"]}],"source":["# ---------- 可复现的平衡选模算法 ----------\n","def score_eligible_models(rows, tolerance=RECON_TOLERANCE, exclude=(), classifier_accuracy=None):\n","    active=[dict(r) for r in rows if r['run'] not in set(exclude)]\n","    if not active:\n","        raise RuntimeError('人工排除后没有任何候选模型。')\n","    best_mean=min(float(r['val_mean_mse']) for r in active)\n","    best_sample=min(float(r['val_sample_mse']) for r in active)\n","    eligible=[r for r in active\n","              if float(r['val_mean_mse']) <= best_mean*(1+tolerance)\n","              and float(r['val_sample_mse']) <= best_sample*(1+tolerance)]\n","    if not eligible:\n","        raise RuntimeError('没有模型同时通过双重重建门槛；请检查结果，不要私自放宽标准。')\n","\n","    proxy_fields=('generated_confidence_ge_08','generated_entropy')\n","    proxy_ok=(classifier_accuracy is not None and classifier_accuracy >= .95\n","              and all(all(r.get(f) is not None and np.isfinite(float(r[f]))\n","                          for f in proxy_fields) for r in eligible))\n","\n","    def score_norm(key, higher_is_better):\n","        vals=[float(r[key]) for r in eligible]\n","        lo,hi=min(vals),max(vals)\n","        # Treat relative differences below 0.5% as nearly tied to avoid\n","        # exaggerating negligible metric differences during normalization.\n","        if hi-lo < 1e-10 or (hi-lo)/max(abs(lo),1e-9) < 0.005:\n","            return [0.5]*len(vals)\n","        return [(v-lo)/(hi-lo) if higher_is_better else (hi-v)/(hi-lo)\n","                for v in vals]\n","\n","    mean_score=score_norm('val_mean_mse',False)\n","    sample_score=score_norm('val_sample_mse',False)\n","    conf_score=score_norm('generated_confidence_ge_08',True) if proxy_ok else [None]*len(eligible)\n","    entropy_score=score_norm('generated_entropy',True) if proxy_ok else [None]*len(eligible)\n","    for i,r in enumerate(eligible):\n","        r['recon_mean_score']=mean_score[i]\n","        r['recon_sample_score']=sample_score[i]\n","        r['reconstruction_score']=0.5*(mean_score[i]+sample_score[i])\n","        if proxy_ok:\n","            r['generation_conf_score']=conf_score[i]\n","            r['generation_entropy_score']=entropy_score[i]\n","            r['generation_score']=0.5*(conf_score[i]+entropy_score[i])\n","            r['balanced_score']=0.5*r['reconstruction_score']+0.5*r['generation_score']\n","        else:\n","            r['generation_conf_score']=None\n","            r['generation_entropy_score']=None\n","            r['generation_score']=None\n","            r['balanced_score']=None\n","    if proxy_ok:\n","        eligible.sort(key=lambda r:(-r['balanced_score'],r['val_sample_mse'],r['val_mean_mse'],r['run']))\n","    else:\n","        eligible.sort(key=lambda r:(-r['reconstruction_score'],r['val_sample_mse'],r['run']))\n","    return eligible,proxy_ok,{'best_val_mean_mse':best_mean,'best_val_sample_mse':best_sample,\n","                              'recon_tolerance':tolerance,'candidate_count':len(eligible)}\n","\n","by_run={r['run']:r for r in summaries}\n","ranking,proxy_valid,selection_rules=score_eligible_models(\n","    summaries,tolerance=RECON_TOLERANCE,\n","    exclude=MANUAL_EXCLUDE_RUNS,classifier_accuracy=clf_acc)\n","\n","print('\\n符合双重重建门槛的模型排名：')\n","for i,r in enumerate(ranking,1):\n","    print(f\"{i}. {r['run']}: mean MSE={r['val_mean_mse']:.6f}, \"\n","          f\"sample MSE={r['val_sample_mse']:.6f}, \"\n","          f\"recon_score={r['reconstruction_score']:.3f}, \"\n","          f\"gen_score={r['generation_score']}, balanced_score={r['balanced_score']}\")\n","print('生成代理指标可信：',proxy_valid,'辅助分类器准确率：',clf_acc)\n","if proxy_valid:\n","    near_ties=[r['run'] for r in ranking if ranking[0]['balanced_score']-r['balanced_score'] <= .03]\n","    if len(near_ties)>1:\n","        print('综合分差距不超过0.03；排序不足以证明某一模型显著更优，请核对：',near_ties)\n","if not proxy_valid:\n","    print('分类器指标不可用；这是重建候选排序，不得称为“自动平衡最优”。')\n","\n","score_fields=['run','beta','warmup','seed','val_mean_mse','val_sample_mse','val_kl',\n","              'generated_confidence_ge_08','generated_entropy','generated_classes_1pct',\n","              'recon_mean_score','recon_sample_score','reconstruction_score',\n","              'generation_conf_score','generation_entropy_score','generation_score','balanced_score']\n","write_csv(TABLES/'balanced_selection_ranking.csv',ranking,score_fields)\n","\n","if FINAL_CHOICE=='auto_balanced':\n","    if proxy_valid:\n","        selected=by_run[ranking[0]['run']]\n","        selection_reason='自动平衡评分推荐，需核对先验生成图'\n","    else:\n","        selected=by_run[ranking[0]['run']]\n","        selection_reason='只有重建候选排序，缺少可靠生成评价，不能认定平衡最优'\n","else:\n","    chosen=f'{FINAL_CHOICE}_seed_{BASE_SEED}'\n","    if chosen not in by_run:\n","        raise ValueError(f'指定的 FINAL_CHOICE 不存在: {chosen}; 可选 {list(by_run)}')\n","    if chosen not in [r['run'] for r in ranking]:\n","        raise ValueError(f'指定模型 {chosen} 未通过双重重建门槛或已被人工排除。')\n","    selected=by_run[chosen]\n","    selection_reason='显式人工指定模型（需确认已经完成目视生成检查）'\n","\n","if VISUAL_REVIEW_CONFIRMED and not proxy_valid and FINAL_CHOICE=='auto_balanced':\n","    raise RuntimeError('生成代理不可用时，必须目视检查并明确填写 FINAL_CHOICE，不能自动宣称平衡最优。')\n","\n","selection_status=('confirmed' if VISUAL_REVIEW_CONFIRMED else 'pending_visual_review')\n","print('\\n推荐模型：',selected['run'])\n","print('状态：',selection_status,'；理由：',selection_reason)\n","print('可视化：',COMPARISONS/'prior_samples_comparison.png')\n","\n","selection_manifest={\n","    'status':selection_status,\n","    'recommended_run':selected['run'],\n","    'selection_reason':selection_reason,\n","    'classifier_validation_accuracy':clf_acc,\n","    'generation_proxy_usable':proxy_valid,\n","    'manual_excluded':list(MANUAL_EXCLUDE_RUNS),\n","    'ranking':ranking,\n","    'near_ties_with_best':([r['run'] for r in ranking if proxy_valid and ranking[0]['balanced_score']-r['balanced_score'] <= .03] if proxy_valid else []),\n","    'rules':{'reconstruction_gate':'mean and sampled MSE <= (1+tolerance)*independent best',\n","             'reconstruction_tolerance':RECON_TOLERANCE,\n","             'weights':{'mean_mse':0.25,'sample_mse':0.25,'confidence_ge_08':0.25,'class_entropy':0.25},\n","             'normalization':'min-max across eligible; relative range <0.5% -> tie score 0.5',\n","             'near_tie_score_margin':0.03,\n","             'manual_visual_review_required':True,\n","             'test_set_not_used_for_model_selection':True},\n","}\n","store_json(TABLES/'balanced_selection_decision.json',selection_manifest)\n","\n","# 仅在选模逻辑和生成样本经人工确认后才执行最终测试集评价。\n","final_rows=[]\n","if VISUAL_REVIEW_CONFIRMED:\n","    base_name=f'{run_key(0.001,False)}_seed_{BASE_SEED}'\n","    needed=list(dict.fromkeys([base_name,selected['run']]))\n","    for name in needed:\n","        model,folder,_=load_for_view(by_run[name])\n","        stat=evaluate(model,test_loader,by_run[name]['seed'],k_repeats=10)\n","        store_json(folder/'FINAL_test_metrics.json',stat)\n","        final_rows.append({'run':name,'test_mean_mse':stat['mean_mse'],\n","                           'test_sample_mse':stat['sample_mse'],'test_kl':stat['kl_total']})\n","        if name == selected['run']:\n","            torch.save({'state_dict':state_cpu(model.state_dict()),\n","                        'architecture':'784-128-32-16-8 (mu4+logvar4) -> 4-16-32-128-784',\n","                        'latent_dim':LATENT_DIM, 'selected_run':name,\n","                        'selection_status':'confirmed','note':'selected by validation; test set held out until confirmation'},\n","                       ROOT/'selected_model_state_dict.pt')\n","        del model\n","    write_csv(TABLES/'final_test_results.csv',final_rows,\n","              ['run','test_mean_mse','test_sample_mse','test_kl'])\n","    print('确认后最终测试：',final_rows)\n","else:\n","    print('尚未完成先验生成图片目视核验：跳过测试集评价与最终模型权重导出。')\n","    print('请查看 comparisons/prior_samples_comparison.png，必要时填入 MANUAL_EXCLUDE_RUNS，')\n","    print('然后设置 VISUAL_REVIEW_CONFIRMED=True，仅重新运行第8-10节。')\n"]},{"cell_type":"markdown","id":"841a58bb","metadata":{"papermill":{"duration":0.004189,"end_time":"2026-11-02T02:59:15.530709+00:00","exception":false,"start_time":"2026-11-02T02:59:15.52652+00:00","status":"completed"},"tags":[]},"source":["## 9. 可选：多随机种子稳定性验证\n","\n","如果开启该实验，会增加额外的训练工作。由于本次选模同时考虑重建与生成，最终建议对候选前两名分别开展多种子复验，不能只根据单次运行的微小分数差异下结论。"]},{"cell_type":"code","execution_count":10,"id":"42244cc7","metadata":{"execution":{"iopub.execute_input":"2026-11-02T02:59:15.541322Z","iopub.status.busy":"2026-11-02T02:59:15.540592Z","iopub.status.idle":"2026-11-02T02:59:15.548041Z","shell.execute_reply":"2026-11-02T02:59:15.54729Z"},"papermill":{"duration":0.015103,"end_time":"2026-11-02T02:59:15.550071+00:00","exception":false,"start_time":"2026-11-02T02:59:15.534968+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["多随机种子复验未开启；需要时设 RUN_EXTRA_SEEDS=True 并重新执行本单元。\n"]}],"source":["if RUN_EXTRA_SEEDS:\n","    records=[]\n","    for seed in (BASE_SEED,*EXTRA_SEEDS):\n","        if seed==BASE_SEED:\n","            stats=selected\n","        else:\n","            model,out,_=train_experiment(selected['beta'],seed,selected['warmup'],EPOCHS)\n","            val=evaluate(model,val_loader,seed,k_repeats=3)\n","            store_json(out/'validation_metrics.json',val)\n","            stats={'val_mean_mse':val['mean_mse'],'val_sample_mse':v