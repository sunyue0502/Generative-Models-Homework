s.backward();opt.step()\n","                n+=len(y);correct+=int((out.argmax(1)==y).sum())\n","            print('classifier epoch',epoch,'train acc',round(correct/n,4))\n","        torch.save(cpu_tree(clf.state_dict()),ROOT/'reference_classifier.pt')\n","    clf.eval();right=0;n=0;confusion=np.zeros((10,10),dtype=np.int64)\n","    with torch.no_grad():\n","        for x,y in val_loader:\n","            p=clf(x.to(device)).argmax(1).cpu().numpy(); t=y.numpy()\n","            right+=int((p==t).sum());n+=len(y)\n","            np.add.at(confusion,(t,p),1)\n","    acc=right/n\n","    (TABLES/'reference_classifier_validation.json').write_text(json.dumps({'accuracy':acc,'valid':acc>=0.95,'validation_count':n},indent=2),encoding='utf-8')\n","    np.savetxt(TABLES/'reference_classifier_confusion.csv',confusion,fmt='%d',delimiter=',')\n","    print('Reference classifier accuracy on REAL validation images:',round(acc,4),'proxy accepted:',acc>=0.95)\n","    for p in clf.parameters():p.requires_grad_(False)\n","    return clf,acc\n","\n","classifier,classifier_acc=get_classifier()\n","PROXY_VALID=classifier_acc>=0.95"]},{"cell_type":"markdown","id":"95e8c05e","metadata":{"papermill":{"duration":0.002748,"end_time":"2026-11-02T15:46:51.554302+00:00","exception":false,"start_time":"2026-11-02T15:46:51.551554+00:00","status":"completed"},"tags":[]},"source":["## 6. 完整验证集评价：MSE、边缘误差、逐类 MSE、重建类别混淆\n","一次性使用**同一批验证图片**评估所有模型。为了识别“辅助分类器原来就看错”的情况，另行统计 `original_correct_subset_accuracy`：仅对原始图像分类正确的验证样本，观察重建后是否仍正确。"]},{"cell_type":"code","execution_count":7,"id":"5c31e529","metadata":{"execution":{"iopub.execute_input":"2026-11-02T15:46:51.561011Z","iopub.status.busy":"2026-11-02T15:46:51.560693Z","iopub.status.idle":"2026-11-02T15:46:51.577927Z","shell.execute_reply":"2026-11-02T15:46:51.57724Z"},"papermill":{"duration":0.022567,"end_time":"2026-11-02T15:46:51.579561+00:00","exception":false,"start_time":"2026-11-02T15:46:51.556994+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["@torch.no_grad()\n","def evaluate(model,loader, repeats=SAMPLED_REPEATS):\n","    model.eval();classifier.eval()\n","    n=0; sse_mean=0.;sse_sample=0.;edge=0.;kl_sum=0.;\n","    class_sse=np.zeros(10);class_n=np.zeros(10,dtype=np.int64)\n","    conf_recon=np.zeros((10,10),dtype=np.int64)\n","    conf_original=np.zeros((10,10),dtype=np.int64)\n","    conf_recon_on_original_correct=np.zeros((10,10),dtype=np.int64)\n","    original_correct=np.zeros(10,dtype=np.int64)\n","    for x,y in loader:\n","        x=x.to(device);y=y.to(device);batch=len(x)\n","        mu,lv=model.encode(x);rec=model.decode(mu)\n","        diff=(rec-x).square().flatten(1).sum(1)\n","        n+=batch;sse_mean+=float(diff.sum().item());edge+=float(edge_l1(rec,x).item())*batch\n","        kl_sum+=float((0.5*(mu.square()+lv.exp()-1-lv)).sum().item())\n","        vals=np.bincount(y.cpu().numpy(),minlength=10);class_n+=vals\n","        class_sse+=np.bincount(y.cpu().numpy(),weights=diff.cpu().numpy(),minlength=10)\n","        for _ in range(repeats):\n","            z=mu+torch.exp(.5*lv)*torch.randn_like(mu)\n","            sse_sample+=float((model.decode(z)-x).square().sum().item())/repeats\n","        if PROXY_VALID:\n","            t=y.cpu().numpy()\n","            p0=classifier(x).argmax(1).cpu().numpy()\n","            pr=classifier(rec).argmax(1).cpu().numpy()\n","            np.add.at(conf_original,(t,p0),1)\n","            np.add.at(conf_recon,(t,pr),1)\n","            mask=p0==t\n","            original_correct+=np.bincount(t[mask],minlength=10)\n","            np.add.at(conf_recon_on_original_correct,(t[mask],pr[mask]),1)\n","    per_class={str(i):float(class_sse[i]/(class_n[i]*784)) if class_n[i] else None for i in range(10)}\n","    result={'mean_mse':sse_mean/(n*784),'sample_mse':sse_sample/(n*784),\n","            'edge_l1':edge/n,'total_kl':kl_sum/n,'per_digit_mse':per_class,'val_count':n,\n","            'classifier_valid':PROXY_VALID}\n","    if PROXY_VALID:\n","        result['reconstruction_class_accuracy']=np.trace(conf_recon)/n\n","        result['original_classifier_accuracy']=np.trace(conf_original)/n\n","        result['original_correct_subset_accuracy']=np.trace(conf_recon_on_original_correct)/max(1,sum(original_correct))\n","        result['per_digit_reconstruction_accuracy']={str(i):float(conf_recon[i,i]/max(1,conf_recon[i].sum())) for i in range(10)}\n","        result['per_digit_accuracy_if_original_correct']={str(i):float(conf_recon_on_original_correct[i,i]/max(1,original_correct[i])) for i in range(10)}\n","        result['directed_confusion']={'4_to_9':int(conf_recon[4,9]),'7_to_9':int(conf_recon[7,9]),\n","                                     '8_to_5':int(conf_recon[8,5]),'8_to_6':int(conf_recon[8,6])}\n","        result['confusion']=conf_recon.tolist()\n","        result['confusion_original']=conf_original.tolist()\n","        result['confusion_on_original_correct']=conf_recon_on_original_correct.tolist()\n","    return result\n","\n","@torch.no_grad()\n","def draw_priors(model,n=64,seed=9001):\n","    model.eval();gen=torch.Generator(device=device.type).manual_seed(seed);out=[]\n","    for start in range(0,n,128):\n","        z=torch.randn(min(128,n-start),model.d,device=device,generator=gen)\n","        out.append(model.decode(z).cpu())\n","    return torch.cat(out)\n","\n","@torch.no_grad()\n","def proxy_prior(model,clf,n=PRIOR_EVAL_N):\n","    gen=draw_priors(model,n);counts=np.zeros(10,dtype=np.int64);good=0;confidence=0.\n","    for i in range(0,n,128):\n","        pred=clf(gen[i:i+128].to(device)).softmax(1)\n","        score,label=pred.max(1)\n","        good+=int((score>=.8).sum());confidence+=float(score.sum())\n","        counts+=np.bincount(label.cpu().numpy(),minlength=10)\n","    p=counts/counts.sum();entropy=float(-(p[p>0]*np.log(p[p>0])).sum()/np.log(10))\n","    return {'prior_conf_ge08':good/n,'prior_mean_confidence':confidence/n,'prior_entropy':entropy,'prior_counts':counts.tolist()}"]},{"cell_typ