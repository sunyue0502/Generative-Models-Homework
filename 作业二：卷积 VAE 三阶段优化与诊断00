       for j in range(3):\n","            for k in range(10):\n","                if rows[j,k]>=0.15:ax.text(k,j,f'{rows[j,k]:.2f}',ha='center',va='center',fontsize=7)\n","    fig.suptitle('Digits 4 / 7 / 8: predicted reconstructed classes')\n","    fig.tight_layout();fig.savefig(FIGS/'p1_478_confusion_focus.png',dpi=180);plt.close(fig)\n","\n","rows=[]\n","for name,r in metrics.items():\n","    for c in range(10):\n","        rows.append({'model':name,'digit':c,'mean_mse':r['per_digit_mse'][str(c)],\n","                     'recon_accuracy':r.get('per_digit_reconstruction_accuracy',{}).get(str(c)),\n","                     'recon_accuracy_if_original_correct':r.get('per_digit_accuracy_if_original_correct',{}).get(str(c))})\n","write_csv(TABLES/'class_metrics.csv',rows,list(rows[0]))\n","\n","# 针对两个“只改变一个因素”的受控对照，保存每个数字的增减量，负值表示得到改善。\n","delta_rows=[]\n","base=metrics['conv_mse_z4']\n","for candidate,study in [('conv_mse_z8','P2: 4D vs 8D'),('conv_mse_edge_z4','P3: MSE vs MSE+edge')]:\n","    cur=metrics[candidate]\n","    for c in range(10):\n","        row={'study':study,'candidate':candidate,'digit':c,\n","             'base_mse':base['per_digit_mse'][str(c)],'candidate_mse':cur['per_digit_mse'][str(c)]}\n","        a,b=row['base_mse'],row['candidate_mse']\n","        row['delta_mse']=None if a is None or b is None else b-a\n","        row['base_class_accuracy']=base.get('per_digit_reconstruction_accuracy',{}).get(str(c))\n","        row['candidate_class_accuracy']=cur.get('per_digit_reconstruction_accuracy',{}).get(str(c))\n","        delta_rows.append(row)\n","write_csv(TABLES/'p2_p3_per_digit_deltas.csv',delta_rows,list(delta_rows[0]))\n","if PROXY_VALID:\n","    fig,ax=plt.subplots(figsize=(10,4.3));xs=np.arange(10)\n","    for name in metrics:\n","        acc=metrics[name]['per_digit_reconstruction_accuracy']\n","        ax.plot(xs,[acc[str(c)] for c in range(10)],marker='o',label=name)\n","    ax.set_xticks(xs);ax.set_ylim(0,1);ax.grid(alpha=.2)\n","    ax.