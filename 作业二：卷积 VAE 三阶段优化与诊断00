","    imgs=torch.stack([x for _,x in items]).to(device)\n","    names=list(trained); cols=1+len(names)\n","    fig,axs=plt.subplots(len(items),cols,figsize=(2.2*cols,2.1*len(items)),squeeze=False)\n","    for i,(orig_idx,x) in enumerate(items):\n","        axs[i,0].imshow(x[0],cmap='gray',vmin=0,vmax=1,interpolation='nearest')\n","        axs[i,0].set_title(f'Digit {d} original #{orig_idx}',fontsize=8);axs[i,0].axis('off')\n","    for j,name in enumerate(names,1):\n","        model=trained[name].eval()\n","        with torch.no_grad():\n","            mu,_=model.encode(imgs);rec=model.decode(mu)\n","            preds=classifier(rec).argmax(1).tolist() if PROXY_VALID else ['?']*len(items)\n","        for i in range(len(items)):\n","            axs[i,j].imshow(rec[i,0].cpu(),cmap='gray',vmin=0,vmax=1,interpolation='nearest')\n","            axs[i,j].set_title(name+f' | pred {preds[i]}',fontsize=7);axs[i,j].axis('off')\n","    fig.suptitle(f'Priority 1: hard examples of true digit {d}; selected based on z4 baseline')\n","    fig.tight_layout();fig.savefig(FIGS/f'p1_hard_digit_{d}.png',dpi=190);plt.close(fig)"]},{"cell_type":"markdown","id":"e00578cc","metadata":{"papermill":{"duration":0.003278,"end_time":"2026-11-02T15:50:16.097824+00:00","exception":false,"start_time":"2026-11-02T15:50:16.094546+00:00","status":"completed"},"tags":[]},"source":["## 9. 相同重建样本、相同维度的先验采样对比与实验汇总\n","4维基准与4维边缘模型使用相同 z∼N(0,I4)，便于直观比较；8维模型的 latent 与4维不同，不能把同一列的数字当作一一对应语义。"]},{"cell_type":"code","execution_count":10,"id":"edff1b56","metadata":{"execution":{"iopub.execute_input":"2026-11-02T15:50:16.106374Z","iopub.status.busy":"2026-11-02T15:50:16.105923Z","iopub.status.idle":"2026-11-02T15:50:24.073078Z","shell.execute_reply":"2026-11-02T15:50:24.072007Z"},"papermill":{"duration":7.973653,"end_time":"2026-11-02T15:50:24.074867+00:00","exception":false,"start_time":"2026-11-02T15:50:16.101214+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":[